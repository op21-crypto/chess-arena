{
  "buildCommand": "pnpm build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/assets/(.*)", "destination": "/assets/$1" },
    { "source": "/api/admin/(.*)", "destination": "/api/auth/me.js" },
    { "source": "/api/tournaments/(.*)", "destination": "/api/auth/me.js" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
